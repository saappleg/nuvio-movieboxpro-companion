# ==============================================================================
# Nuvio MovieBoxPro Companion & Discovery Hub - Environment Configuration
# ==============================================================================

# Private Access Keys:
# Generate two different long random values (e.g. `openssl rand -hex 32`).
COMPANION_KEY=replace-with-a-long-random-value
PLUGIN_SETUP_KEY=replace-with-a-different-long-random-value

# Server Bind Configuration:
# Use 127.0.0.1 for local-only use. For phones or Android TVs on your local network,
# set this to the host's private LAN address (e.g. 192.168.1.100).
# In Docker, this is automatically set to 0.0.0.0 inside the container.
HOST=127.0.0.1
PORT=43110
STREAM_TIMEOUT_MS=45000
# Route resolved playback through the companion so clients receive stable
# access even when they cannot attach MovieBoxPro's required HTTP headers.
STREAM_PROXY_ENABLED=true

# Docker / Tailscale / Private VPN Network Configuration:
# The URL Nuvio client devices use to reach the companion (e.g. your Tailscale IP).
# COMPANION_PUBLIC_URL=http://100.64.12.34:43110
# PRIVATE_BIND_IP=100.64.12.34

# Private Browser Desktop (noVNC) Password:
# Used for the visual login window in Docker. VNC uses up to the first 8 characters.
# NOVNC_PASSWORD=replace-with-secure-password

# The Movie Database (TMDb) Credentials:
# Required for Discovery catalogs, metadata, ratings, and recommendation features.
# Obtain a free API key at: https://www.themoviedb.org/settings/api
TMDB_API_KEY=replace-with-your-tmdb-v3-api-key
# TMDB_BEARER_TOKEN=replace-with-your-tmdb-read-access-token

# Timezone Preference:
# Set your IANA timezone (e.g. America/New_York, Europe/London, Asia/Tokyo)
# to accurately calculate local calendar day boundaries and premiere countdowns.
# USER_TIMEZONE=America/New_York

# Browser Profile Storage:
# Directory where persistent MovieBoxPro browser session and cookies are kept.
MOVIEBOXPRO_PROFILE=work/movieboxpro-profile

# Profile metadata and secondary browser sessions. In Docker, set this to
# `/data/profiles.json` so the entire multi-profile setup stays on the volume.
# COMPANION_PROFILES_FILE=work/profiles.json

# Persistent Configuration File:
# In Docker, this points to `/data/companion.env` so dashboard settings persist across container recreation.
# COMPANION_CONFIG=.env

# Nuvio Cloud Integration (Configured automatically via the Setup Dashboard):
# NUVIO_CLOUD_EMAIL=
# NUVIO_CLOUD_TOKEN=
# NUVIO_CLOUD_PROFILE_ID=1
# NUVIO_CLOUD_PROFILE_NAME=Default Profile
# NUVIO_CLOUD_LAST_SYNC=
