# Generate two different long random values, for example with `openssl rand -hex 32`.
COMPANION_KEY=replace-with-a-long-random-value
PLUGIN_SETUP_KEY=replace-with-a-different-long-random-value

# Use 127.0.0.1 only when Nuvio runs on this computer. For a phone or TV,
# use this computer's exact private LAN address (for example 192.168.1.20).
# Do not use 0.0.0.0 and never forward this port through your router.
HOST=127.0.0.1
PORT=43110
STREAM_TIMEOUT_MS=45000

# Docker/private-VPN deployments: the URL Nuvio devices use to reach the host.
# Example: http://100.64.12.34:43110 (the server's Tailscale IP).
# COMPANION_PUBLIC_URL=http://100.64.12.34:43110
# PRIVATE_BIND_IP=100.64.12.34

# Required by docker-compose for the private browser desktop. VNC uses the
# first eight characters, so use an unpredictable eight-character password.
# NOVNC_PASSWORD=replace-me

# Kept only on this Mac. Never commit or share this value.
# Either credential form works. Prefer TMDB_API_KEY when available.
TMDB_API_KEY=replace-with-your-tmdb-v3-api-key
# TMDB_BEARER_TOKEN=replace-with-your-tmdb-read-access-token

# Optional: use a separate location for the dedicated MovieBoxPro browser profile.
MOVIEBOXPRO_PROFILE=work/movieboxpro-profile

# Optional: persistent configuration file location. Docker sets this to
# /data/companion.env so dashboard changes survive container replacement.
# COMPANION_CONFIG=.env
